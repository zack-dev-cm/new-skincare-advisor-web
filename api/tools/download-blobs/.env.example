# Azure Blob Storage connection
# Nome dell'account di storage (obbligatorio)
AZURE_STORAGE_ACCOUNT=stdermaselfprdwesteurope

# Chiave dell'account di storage (opzionale - se non presente usa DefaultAzureCredential/Azure CLI)
AZURE_STORAGE_KEY=

# Container da scaricare, separati da virgola
CONTAINERS=selfies,user-images

# Percorso locale di destinazione dove salvare tutte le immagini scaricate
DOWNLOAD_DEST_PATH=C:\Dermaself\blobs-local

# Percorso del file di stato (default: download-state.json nella stessa cartella dello script)
# STATE_FILE_PATH=./download-state.json
