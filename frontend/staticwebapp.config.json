{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/_next/*",
      "/static/*",
      "/*.css",
      "/*.scss",
      "/*.js",
      "/*.png",
      "/*.gif",
      "/*.ico",
      "/*.jpg",
      "/*.svg",
      "/*.woff",
      "/*.woff2",
      "/*.ttf",
      "/*.eot",
      "/favicon.ico",
      "/images/*",
      "/fonts/*"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "headers": [
    {
      "route": "/*",
      "headers": {
        "Permissions-Policy": "camera=*, microphone=*, geolocation=*",
        "X-Frame-Options": "ALLOWALL"
      }
    },
    {
      "route": "/_next/static/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/*.@(jpg|jpeg|gif|png|svg|ico)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    }
  ]
}
